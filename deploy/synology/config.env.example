# KPPDF 8.0 — конфиг деплоя (скопируй в config.env и заполни)
# copy deploy\synology\config.env.example deploy\synology\config.env

PLATFORM=ubuntu

# LAN Synology Ubuntu VM (при VPN часто недоступен — выключи VPN)
DEPLOY_HOST=192.168.1.103
DEPLOY_USER=tiit
# DEPLOY_PASSWORD=
# Prefer key auth after first install:
# DEPLOY_SSH_KEY=C:\Users\YOU\.ssh\kppdf80-vm

# Код (перезаписывается при деплое)
REMOTE_DIR=/opt/kppdf-8.0
# Данные Mongo + uploads + backups
KPPDF_DATA_DIR=/var/lib/kppdf80

JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_64_HEX
# Required in production (≥12, NOT the demo default)
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Canonical public origin
CORS_ORIGIN=https://kppdf-crm.ru

# Device enrollment (owner «Добавить мой компьютер» link lifetime)
# 2880 min = 2 days — create at home, open at work later
DEVICE_OWNER_INVITE_TTL_MINUTES=2880
DEVICE_ENROLL_BASE_URL=https://kppdf-crm.ru
# Optional desktop installer URL. Prefer versioned zip after TZD-46:
# DESKTOP_DOWNLOAD_URL=/downloads/kppdf-desktop-setup-v0.5.2.zip
# Unversioned /downloads/kppdf-desktop-setup.zip remains alias → same build.
# DESKTOP_DOWNLOAD_URL= (explicit empty) disables the pairing download button.
# Legacy example (exe):
# DESKTOP_DOWNLOAD_URL=https://kppdf-crm.ru/downloads/kppdf-desktop-setup.exe

# Desktop version gate (TZD-40): semver (major.minor.patch), optional.
# Unset = fail-open (no banner). Client compares its own version against these.
# After next warm deploy set to the build you actually published:
# DESKTOP_MIN_VERSION=0.5.2
# DESKTOP_RECOMMENDED_VERSION=0.5.2
# Canon: docs/audits/2026-08-12-desktop-download-version-naming-canon.md
# False-positive MCP exit (code 0 after listening): fixed in 0.5.2 (mcpHost close handler).

# Sentry (error tracking) — оставить пустым чтобы отключить
SENTRY_DSN=

# First deploy / clean reinstall
SEED=true
# WIPE=true   # stops containers, clears REMOTE_DIR + mongo data (dev-only!)
