{
  "name": "kppdf-8.0",
  "version": "0.1.0",
  "private": true,
  "description": "kppdf-8.0 — ERP-система (NestJS backend + Angular frontend). Local dev orchestrator.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node start.mjs --check",
    "start:all": "node start.mjs",
    "start:tail": "node start.mjs --tail",
    "check:start": "node start.mjs --check",
    "stop:start": "node start.mjs --stop",
    "reset:start": "node start.mjs --reset",
    "start:no-browser": "node start.mjs --no-browser",
    "start:prod": "node start.mjs --prod",
    "check:page-docs": "npx tsx scripts/check-page-docs.ts",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "team-room": "node OrchestratorKit/team-room/cli.mjs",
    "team-room:open": "node OrchestratorKit/team-room/cli.mjs open",
    "lmstudio:check": "node scripts/lmstudio-agent/run.mjs --check",
    "lmstudio:eval": "node scripts/lmstudio-agent/run.mjs --eval",
    "lmstudio": "node scripts/lmstudio-agent/run.mjs"
  },
  "lint-staged": {
    "frontend/**/*.ts": [
      "pnpm --dir frontend exec eslint --fix",
      "pnpm --dir frontend exec prettier --write"
    ],
    "frontend/**/*.html": [
      "pnpm --dir frontend exec prettier --write --parser angular"
    ],
    "frontend/**/*.{scss,css}": [
      "pnpm --dir frontend exec prettier --write"
    ]
  },
  "comments": {
    "start": "Default: pre-flight checks only (safe, exits cleanly). Use `npm run start:all` to actually start everything.",
    "start:all": "Полный запуск: Mongo + backend + frontend + browser. Делегирует к start.mjs.",
    "start:tail": "TUI-режим: live-логи в одном TTY-окне (--tail). 3 строки статуса с in-place обновлением, ring buffer последних 5 строк на сервис.",
    "check:start": "Только pre-flight проверки. Не запускает ничего.",
    "stop:start": "Останавливает backend + frontend.",
    "reset:start": "Полный сброс: docker down -v + rm node_modules.",
    "start:no-browser": "Запуск без авто-открытия браузера."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0"
  },
  "dependencies": {
    "@kodadev/koda-cli": "^1.0.1"
  }
}
