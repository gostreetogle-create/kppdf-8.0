NODE_ENV=development
PORT=3000

# MongoDB (требуется Replica Set для транзакций)
MONGO_URI=mongodb://localhost:27017/kppdf?replicaSet=rs0
MONGO_DB=kppdf
MONGO_REPLICA_SET=rs0

# CORS (список разрешённых origins через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Логирование
LOG_LEVEL=debug

# JWT
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-long-random-string-different-from-access
JWT_REFRESH_EXPIRES_IN=7d

# Администратор по умолчанию (создаётся при первом запуске, если нет пользователей)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me-immediately-in-production

# Throttler (ограничение частоты запросов)
# THROTTLE_TTL_SHORT=1000  # окно в мс
# THROTTLE_LIMIT_SHORT=10
# THROTTLE_TTL_LONG=60000
# THROTTLE_LIMIT_LONG=100
# DISABLE_THROTTLE=1
