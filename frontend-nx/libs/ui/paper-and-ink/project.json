{
  "name": "paper-and-ink",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/paper-and-ink/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/ui/paper-and-ink",
        "main": "libs/ui/paper-and-ink/src/index.ts",
        "tsConfig": "libs/ui/paper-and-ink/tsconfig.lib.json",
        "assets": ["libs/ui/paper-and-ink/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/ui/paper-and-ink/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
